# raw third-party datasets are NOT committed (licences differ; see docs/DATA_AND_LICENSES.md)
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/_extracted/
# derived row-level data is regenerated by ml/scripts/ingest.py
ml/data/processed/*.csv
ml/reports/*.log
ml/reports/test_predictions.csv
ml/reports/split_assignment.csv
# runtime
.env
.env*.local
backend/data/
*.sqlite3
__pycache__/
*.pyc
.pytest_cache/
.venv/
node_modules/
.DS_Store
Thumbs.db
.coverage
htmlcov/
.vscode/
.idea/
