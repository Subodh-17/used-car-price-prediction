# Copy to .env (or export in your shell / hosting dashboard). Placeholders only - no real secrets belong here.
# Paths (defaults are relative to the repository; override for containers)
MODELS_DIR=ml/models
ML_DIR=ml
HISTORY_DB_PATH=backend/data/history.sqlite3
FRONTEND_DIR=frontend

# Comma-separated list of browser origins allowed to call the API (only needed if the frontend is hosted separately)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# Limits
MAX_BODY_BYTES=16384
PREDICT_TIMEOUT_S=10
HISTORY_LIMIT=100
LOG_LEVEL=INFO

# Random string used to salt the hash of anonymous client ids in the history table. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
HISTORY_SALT=replace-with-a-long-random-string

# Used only by `npm run configure` in frontend/ when the API is on a different origin than the frontend
API_BASE_URL=
